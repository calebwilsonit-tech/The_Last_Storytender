; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="The Last Storytender"
config/description="A sentient doodle in the margins of an abandoned manuscript. The world is not ending; it is being edited."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

InputSetup="*res://scripts/input_setup.gd"
GameState="*res://scripts/game_state.gd"
Transition="*res://scripts/transition.gd"
Telemetry="*res://scripts/telemetry.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/IMFellEnglish-Regular.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
