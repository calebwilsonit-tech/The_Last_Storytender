{
  "schemaVersion": 1,
  "name": "shard_3",
  "start": "n13",
  "nodes": [
    {
      "id": "n1",
      "type": "line",
      "speaker": "",
      "text": "[i]Dawn, nearly. The forge is loud and warm. A boy who has not slept brings the hammer down one last time.[/i]",
      "next": "n2"
    },
    {
      "id": "n2",
      "type": "line",
      "speaker": "Young Garrick",
      "text": "Come on. Third time.",
      "next": "n3"
    },
    {
      "id": "n3",
      "type": "line",
      "speaker": "",
      "text": "[i]The blade rings. It is not perfect. There is a slight, stubborn bend near the tip.[/i]",
      "next": "n4"
    },
    {
      "id": "n4",
      "type": "line",
      "speaker": "Young Garrick",
      "text": "...There.",
      "next": "n5"
    },
    {
      "id": "n5",
      "type": "line",
      "speaker": "Wren",
      "text": "...is it straight?",
      "next": "n6"
    },
    {
      "id": "n6",
      "type": "line",
      "speaker": "Young Garrick",
      "text": "No. It's yours.",
      "next": "n7"
    },
    {
      "id": "n7",
      "type": "line",
      "speaker": "",
      "text": "[i]In the dark above the forge, the red voice says very quietly, It was never good enough. And it does not sound like a critic. It sounds like a boy who was tired.[/i]",
      "next": "n8"
    },
    {
      "id": "n8",
      "type": "set",
      "variable": "shard_3",
      "op": "set",
      "value": 1,
      "next": "n9"
    },
    {
      "id": "n9",
      "type": "line",
      "speaker": "",
      "text": "[i]Three.[/i]"
    },
    {
      "id": "n10",
      "type": "end"
    },
    {
      "id": "n11",
      "type": "branch",
      "if": {
        "kind": "variable",
        "name": "shard_3",
        "op": ">=",
        "value": 1
      },
      "then": "n10",
      "else": "n1"
    },
    {
      "id": "n12",
      "type": "line",
      "speaker": "",
      "text": "[i]A splinter of something remembered. It is not time yet.[/i]"
    },
    {
      "id": "n13",
      "type": "branch",
      "if": {
        "kind": "variable",
        "name": "critic_awake",
        "op": ">=",
        "value": 1
      },
      "then": "n11",
      "else": "n12"
    }
  ]
}
